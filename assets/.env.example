# Slackernews Docker Compose Environment Variables
# Copy this file to .env and fill in all values marked with <...>

# ------------------------------------------------------------------------------
# Required: Domain
# ------------------------------------------------------------------------------
# The public domain where Slackernews will be served.
# Caddy will provision a TLS certificate for this domain via Let's Encrypt.
# This must match the DNS A/AAAA record pointing to this host.
# Note: Ports 80 and 443 on the host must be free for Caddy to bind. If you
# have another service using those ports, stop it before running docker compose up.
SLACKERNEWS_DOMAIN=<your-domain.com>

# ------------------------------------------------------------------------------
# Let's Encrypt Staging (optional — remove for production)
# ------------------------------------------------------------------------------
# Uncomment the line below to use the Let's Encrypt staging server during
# initial setup. This avoids rate limits while testing. The Caddyfile already
# defaults to the production CA, so you only need to set this for staging.
# Once everything works, comment or remove this line to switch to production.
# CADDY_TLS_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# ------------------------------------------------------------------------------
# Required: Slack OAuth Credentials
# ------------------------------------------------------------------------------
# Create a Slack app at https://api.slack.com/apps and copy the credentials
# from the "OAuth & Permissions" and "Basic Information" pages.
# The redirect URI in your Slack app must be:
#   https://${SLACKERNEWS_DOMAIN}/login/callback
SLACKERNEWS_SLACK_AUTH_CLIENT_ID=<your-slack-client-id>
SLACKERNEWS_SLACK_AUTH_CLIENT_SECRET=<your-slack-client-secret>
SLACKERNEWS_SLACK_USER_TOKEN=<your-slack-user-token>
SLACKERNEWS_SLACK_BOT_TOKEN=<your-slack-bot-token>

# ------------------------------------------------------------------------------
# Required: OAuth Redirect URI
# ------------------------------------------------------------------------------
# Must match the redirect URI registered in your Slack app's
# OAuth & Permissions settings. Derived from SLACKERNEWS_DOMAIN.
SLACK_AUTH_REDIRECT_URI=https://${SLACKERNEWS_DOMAIN}/login/callback

# ------------------------------------------------------------------------------
# Required: Database
# ------------------------------------------------------------------------------
# Password for the PostgreSQL database. Must match the password in DB_URI below.
# If your password contains special characters (@, :, /, #, etc.), URL-encode them
# or set DB_URI manually instead of using the variable substitution below.
POSTGRES_PASSWORD=<choose-a-strong-password>

# Connection string for the PostgreSQL database.
# The hostname 'postgres' resolves to the postgres container on the Docker network.
# This value is expanded by Docker Compose using the POSTGRES_PASSWORD set above.
DB_URI=postgresql://slackernews:${POSTGRES_PASSWORD}@postgres:5432/slackernews

# ------------------------------------------------------------------------------
# Optional: Admin Users
# ------------------------------------------------------------------------------
# Comma-separated list of email addresses that will be granted super-admin
# privileges on first login. Use the email associated with your Slack account.
SLACKERNEWS_ADMIN_USER_EMAILS=<your-admin-email@example.com>

# ------------------------------------------------------------------------------
# Optional: SlackerNews Image
# ------------------------------------------------------------------------------
# The Replicated proxy registry image to pull. Update the tag to match your
# licensed release version. This defaults to :latest if not set.
# SLACKERNEWS_IMAGE=registry.replicated.com/slackernews/slackernews-web:latest
